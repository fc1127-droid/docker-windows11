{
    "name": "Windows 11 Codespace",

    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4": {}
    },

    "workspaceFolder": "/workspaces/docker-windows11",

    "forwardPorts": [
        3389,
        8006
    ],

    "portsAttributes": {
        "3389": {
            "label": "Windows 11 RDP",
            "protocol": "tcp",
            "onAutoForward": "notify"
        },
        "8006": {
            "label": "Windows 11 Web",
            "protocol": "http",
            "onAutoForward": "openBrowser"
        }
    },

    "privileged": true,

    "runArgs": [
        "--device=/dev/kvm",
        "--device=/dev/net/tun",
        "--device=/dev/vhost-net"
    ],

    "securityOpt": [
        "seccomp=unconfined"
    ],

    "mounts": [
        "source=var-lib-docker,target=/var/lib/docker,type=volume"
    ],

    "remoteUser": "vscode",

    "postStartCommand": "sudo bash /workspaces/docker-windows11/start-windows.sh",

    "waitFor": "postStartCommand"
}ileged": true,

    "runArgs": [
        "--device=/dev/kvm",
        "--device=/dev/net/tun",
        "--device=/dev/vhost-net"
    ],

    "securityOpt": [
        "seccomp=unconfined"
    ],

    "remoteUser": "codespace",

    "postStartCommand": "bash /workspaces/docker-windows11/start-windows.sh",

    "waitFor": "postStartCommand"
}
