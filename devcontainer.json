{
  "name": "Windows 11 Codespace",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "remoteUser": "root",
  "privileged": true,

  "runArgs": [
    "--device=/dev/kvm",
    "--device=/dev/fuse"
  ],

  "forwardPorts": [
    8006,
    3389
  ],

  "portsAttributes": {
    "8006": {
      "label": "Windows 11 Web",
      "protocol": "http",
      "onAutoForward": "notify"
    },
    "3389": {
      "label": "Windows 11 RDP",
      "protocol": "tcp",
      "onAutoForward": "notify"
    }
  },

  "postStartCommand": "bash /workspaces/${localWorkspaceFolderBasename}/start-docker.sh && bash /workspaces/${localWorkspaceFolderBasename}/start-windows.sh"
}
